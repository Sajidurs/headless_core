# =============================================================================
#  Copy to .env.local and fill in. Never commit .env.local.
#
#  Every one of these must also be set in Vercel, for BOTH the Production and
#  Preview environments (Project Settings -> Environment Variables).
# =============================================================================

# --- WordPress ---------------------------------------------------------------
# The GraphQL endpoint on the cms. subdomain.
WP_GRAPHQL_URL=https://cms.example.com/graphql

# The public site. NEXT_PUBLIC_ exposes it to the browser, which is required —
# it appears in canonical URLs, the sitemap, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Draft preview -----------------------------------------------------------
# A WordPress Editor account plus an Application Password
# (Users -> Profile -> Application Passwords). Server-side only.
# Create a dedicated user; do not use your own admin account.
WP_APP_USER=headless-preview
WP_APP_PASSWORD=

# --- Shared secrets ----------------------------------------------------------
# Must be byte-identical to the values in wp-config.php.
# Generate each with:  openssl rand -hex 32
PREVIEW_SECRET=
REVALIDATE_SECRET=

# --- Contact form ------------------------------------------------------------
RESEND_API_KEY=
CONTACT_TO=
